# The guided tour's generated steps file is deliberately committed so the
# repo analyzes without running the merge (CI regenerates it in-workspace
# on every tour run but only commits marketing/tour outputs).
!integration_test/tour_steps.g.dart

npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Miscellaneous
*.class
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# Everything in lib/ is regenerated by compose, so it is not tracked -
# EXCEPT main.dart, which is hand-authored app composition and which the
# installer likewise refuses to overwrite. Note 'lib/*' not 'lib/': git
# cannot re-include a file whose parent directory is excluded, so a bare
# 'lib/' rule would make the negation below silently inert.
lib/

# Composed SDK sources and composer scratch - regenerated by compose
.rokct/cache/
.rokct/__pycache__/
