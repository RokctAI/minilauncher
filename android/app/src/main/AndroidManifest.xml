<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- HMS wave (hms_sdk): huawei_hmsavailability 6.13.0+300 declares
         minSdk 26 in its Android library while the fleet ships minSdk 24
         (flutter.minSdkVersion), which fails the manifest merge in every
         composed app build. Override is safe: hms_sdk's Dart DeviceServices
         wraps every HMS call in try/catch and fail-opens to GMS, so a device
         below the library's expectations degrades gracefully at runtime
         instead of failing. Inert when the HMS plugins are not in the build.
         (huawei_push declares minSdk 21 and needs no override.) -->
    <uses-sdk
        tools:overrideLibrary="com.huawei.hms.flutter.hmsavailability"/>
    <!-- @sdk-android-permissions-start -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <uses-permission android:name="android.permission.VIBRATE"/>
    <!-- @sdk-android-permissions-end -->
    <uses-permission
        android:name="android.permission.INTERNET"/>
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" />

    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
        </intent>
    </queries>

    <!-- Backup / device-transfer policy. allowBackup stays true so the app
         still restores, but res/xml/data_extraction_rules.xml (API 31+) and
         res/xml/backup_rules.xml (pre-31) exclude every credential-bearing
         store: the offline sqlite database, the plain SharedPreferences file
         and the flutter_secure_storage EncryptedSharedPreferences file (whose
         Keystore master key is not backed up, so a restored copy is
         undecryptable). tools:replace pins these against library manifests
         that declare their own android:allowBackup. -->
    <application
        android:label="minimal_launcher"
        android:name="${applicationName}"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        tools:replace="android:allowBackup,android:dataExtractionRules,android:fullBackupContent">
        <!-- Home-activity shell flags. A HOME activity is relaunched by the
             system in states a normal activity never sees: cold start with no
             saved instance state after the process is killed for memory, and
             repeated MAIN/HOME intents while it is already resumed.
             stateNotNeeded lets the system restart it without restoring a
             saved bundle instead of tearing it down; singleTask keeps every
             HOME intent routed to the one existing instance at the root of its
             task rather than stacking new ones on top; excludeFromRecents
             keeps the home surface itself out of the recents list. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:stateNotNeeded="true"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
                <category android:name="android.intent.category.HOME"/>
                <category android:name="android.intent.category.DEFAULT"/>
            </intent-filter>
        </activity>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
</manifest>
