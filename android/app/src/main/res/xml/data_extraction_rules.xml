<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12+ (API 31+) backup / transfer policy. Pre-31 devices read
  res/xml/backup_rules.xml instead (android:fullBackupContent); keep the two
  files in step.

  Everything is backed up EXCEPT the credential-bearing stores listed below.
  Rationale:
    * rokct_app.sqlite carries a live backendToken and an unsalted SHA-256
      passwordHash in OfflineUsersTable.
    * FlutterSharedPreferences.xml carries the access token and the full
      cached user JSON (base_sdk LocalStorage).
    * FlutterSecureStorage.xml is an EncryptedSharedPreferences file whose
      Keystore master key is NOT part of any backup, so a restored copy is
      undecryptable and corrupts the store on the target device.
  App data is server-authoritative and re-syncs after sign-in, so nothing of
  value is lost; identity migration is what the Restore Credentials work
  replaces token-copying with.

  Paths verified, not guessed:
    * path_provider_android 2.3.1
      (lib/src/path_provider_android_real.dart, getApplicationDocumentsPath)
      returns Context.getDir("flutter", MODE_PRIVATE), i.e. <dataDir>/app_flutter
      , not getFilesDir(), so the database sits in the `root` domain at
      app_flutter/, not the `file` or `database` domain.
    * shared_preferences_android 2.4.23 uses SHARED_PREFERENCES_NAME
      "FlutterSharedPreferences" (LegacySharedPreferencesPlugin.java for the
      SharedPreferences API this SDK uses, and the same name for the
      DataStore-backed SharedPreferencesAsync API, which lands in
      <filesDir>/datastore/FlutterSharedPreferences.preferences_pb; excluded
      too so a future migration to that API stays covered).
    * flutter_secure_storage 9.2.4 uses "FlutterSecureStorage"
      (FlutterSecureStorage.java) plus "FlutterSecureKeyStorage"
      (ciphers/StorageCipher18Implementation.java) for the wrapped key.
    * The `sharedpref` domain path includes the .xml suffix (Android's
      Auto Backup docs show <exclude domain="sharedpref" path="device.xml"/>).
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="FlutterSecureStorage.xml"/>
        <exclude domain="sharedpref" path="FlutterSecureKeyStorage.xml"/>
        <exclude domain="sharedpref" path="FlutterSharedPreferences.xml"/>
        <exclude domain="file" path="datastore/FlutterSharedPreferences.preferences_pb"/>
        <exclude domain="root" path="app_flutter/rokct_app.sqlite"/>
        <exclude domain="root" path="app_flutter/rokct_app.sqlite-wal"/>
        <exclude domain="root" path="app_flutter/rokct_app.sqlite-shm"/>
        <exclude domain="root" path="app_flutter/rokct_app.sqlite-journal"/>
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="FlutterSecureStorage.xml"/>
        <exclude domain="sharedpref" path="FlutterSecureKeyStorage.xml"/>
        <exclude domain="sharedpref" path="FlutterSharedPreferences.xml"/>
        <exclude domain="file" path="datastore/FlutterSharedPreferences.preferences_pb"/>
        <exclude domain="root" path="app_flutter/rokct_app.sqlite"/>
        <exclude domain="root" path="app_flutter/rokct_app.sqlite-wal"/>
        <exclude domain="root" path="app_flutter/rokct_app.sqlite-shm"/>
        <exclude domain="root" path="app_flutter/rokct_app.sqlite-journal"/>
    </device-transfer>
</data-extraction-rules>
