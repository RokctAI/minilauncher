<?xml version="1.0" encoding="utf-8"?>
<!--
  Pre-Android-12 (API < 31) Auto Backup policy, referenced by
  android:fullBackupContent. Android 12+ reads
  res/xml/data_extraction_rules.xml instead; the exclusion set must stay
  identical in both files. See data_extraction_rules.xml for the rationale
  and for how each path was verified.
-->
<full-backup-content>
    <exclude domain="sharedpref" path="FlutterSecureStorage.xml"/>
    <exclude domain="sharedpref" path="FlutterSecureKeyStorage.xml"/>
    <exclude domain="sharedpref" path="FlutterSharedPreferences.xml"/>
    <exclude domain="file" path="datastore/FlutterSharedPreferences.preferences_pb"/>
    <exclude domain="root" path="app_flutter/rokct_app.sqlite"/>
    <exclude domain="root" path="app_flutter/rokct_app.sqlite-wal"/>
    <exclude domain="root" path="app_flutter/rokct_app.sqlite-shm"/>
    <exclude domain="root" path="app_flutter/rokct_app.sqlite-journal"/>
</full-backup-content>
